# DB configuration
DB_JDBC_URL=jdbc:postgresql://postgres:5432/monitoringdb
DB_USER=user
DB_PASSWORD=password
DB_DRIVER=

# Kafka Consumer configuration
KAFKA_CONSUMER_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP_ID=test_group_consumer
KAFKA_CONSUMER_AUTO_OFFSET_RESET=latest

# Kafka Producer configuration
KAFKA_PRODUCER_BOOTSTRAP_SERVERS=kafka:9092

# Kafka Topics
KAFKA_TOPIC_IN=test_topic_in
KAFKA_TOPIC_OUT=test_topic_out

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Application configuration
APPLICATION_UPDATE_INTERVAL_SEC=30
